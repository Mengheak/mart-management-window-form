<?xml version="1.0" encoding="utf-8" ?>
<configuration>

  <connectionStrings>
    <add name="MiniMartDb"
         connectionString="Server=localhost,1434;Database=MiniMartDB;User ID=sa;Password=Heak020507#;TrustServerCertificate=True;Application Name=MiniMartManagementSystem;Connect Timeout=15"
         providerName="Microsoft.Data.SqlClient" />

    <!-- Previous target: the local SQL Server 2014 instance, still running on 1433.
    <add name="MiniMartDb"
         connectionString="Server=.;Database=MiniMartDB;Trusted_Connection=True;TrustServerCertificate=True;Application Name=MiniMartManagementSystem;Connect Timeout=15"
         providerName="Microsoft.Data.SqlClient" />
    -->
  </connectionStrings>

  <appSettings>
    <!-- Store details printed at the top of every receipt. -->
    <add key="Store.Name" value="Mini Mart" />
    <add key="Store.Address" value="123 Market Street" />
    <add key="Store.Phone" value="(000) 000-0000" />
    <!-- Currency symbol used across the POS and reporting screens. -->
    <add key="Ui.CurrencySymbol" value="$" />
  </appSettings>

</configuration>
